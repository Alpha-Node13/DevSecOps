# Secure Dockerfile - Following Best Practices

# 1. Use a recent, minimal base image with latest security patches
FROM python:3.11-slim

# 2. Create a non-root user for running the application
RUN groupadd -r appuser && useradd -r -g appuser appuser

# 3. Set working directory
WORKDIR /app

# 4. Copy only necessary files
COPY app.py /app/

# 5. Install only required dependencies with specific versions
RUN pip install --no-cache-dir flask==3.0.0

# 6. Set proper file permissions (read-only for application files)
RUN chown -R appuser:appuser /app && \
    chmod 755 /app && \
    chmod 644 /app/app.py

# 7. Expose only necessary ports
EXPOSE 8080

# 8. Switch to non-root user
USER appuser

# 9. Use environment variables for configuration (no hardcoded secrets)
ENV FLASK_ENV=production

# 10. Run application on non-privileged port
CMD ["python", "app.py"]